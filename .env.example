PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/university?retryWrites=true&w=majority
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_secret
# How long a login lasts WITHOUT being used. Active users are renewed automatically and stay logged in until Logout.
JWT_EXPIRES_IN=30d

# Frontend URL(s) allowed by CORS (comma separated). The first one is also used for payment redirects.
CLIENT_URL=http://localhost:5173

# Seed (first University Head account)
SEED_PRINCIPAL_NAME=University Principal
SEED_PRINCIPAL_EMAIL=principal@university.edu
SEED_PRINCIPAL_PASSWORD=ChangeMe@12345

# ---- Online payments ----
# "mock"   = built-in gateway simulator for development and FYP demos (refused when NODE_ENV=production)
# "stripe" = real Stripe Checkout (card details never touch this server)
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (webhook URL: <server>/api/payments/webhook/stripe, event: checkout.session.completed)

# ---- SMS: the confirmation message a student gets when the finance office receives a payment ----
# console = (development / FYP demo) the SMS is printed in this server window instead of being sent. Recommended while testing.
# twilio  = real text messages through Twilio (needs a Twilio account; fill the three lines below)
# Leave SMS_PROVIDER out to turn SMS off (students still get the in-app notification).
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1555...
# Used when a saved phone number starts with 0, for example 0300 1234567 becomes +92 300 1234567
SMS_DEFAULT_COUNTRY_CODE=+92

# ---- Vercel only ----
# Vercel has no timers, so a daily Vercel Cron call runs the background jobs (see server/vercel.json and docs/VERCEL.md).
# Set any long random text; Vercel sends it automatically to protect /api/cron.
# CRON_SECRET=

# ---- Unpaid-student reminders to the HODs ----
# How many days before a payment / late-payment deadline the first automatic list is sent (a second one goes out on the day itself).
FEE_REMINDER_DAYS=3

# ---- AI assistant (server side only, never in React) ----
# Without a key the assistant still works: it returns the most relevant passages of the course materials.
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5-5
